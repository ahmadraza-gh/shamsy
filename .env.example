NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local/CI test tooling only. Never add these values to the deployed app.
SUPABASE_SERVICE_ROLE_KEY=

# Required when provisioning and running disposable integration/E2E tests.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_ADVISER_EMAIL=adviser@example.invalid
E2E_ADVISER_PASSWORD=
E2E_OWNER_EMAIL=owner@example.invalid
E2E_OWNER_PASSWORD=
